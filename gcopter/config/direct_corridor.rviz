Panels:
- Class: gcopter/CorridorPanel
  Name: Corridor
  Obstacle Transparency: 84
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.22
    Cell Size: 2
    Class: rviz_default_plugins/Grid
    Color: 166; 181; 197
    Enabled: true
    Line Style:
      Line Width: 0.015
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 30
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/Axes
    Enabled: false
    Length: 2
    Name: Axes
    Radius: 0.10000000149011612
    Reference Frame: <Fixed Frame>
    Value: false
  - Class: gcopter/GhostMap
    Name: Environment
    Opacity: 0.16
    Enabled: true
    Value: true
    Topic:
      Value: /direct_demo/map_surface
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/MarkerArray
    Name: Corridor surface
    Enabled: true
    Value: true
    Topic:
      Value: /direct_demo/corridor
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/MarkerArray
    Name: Cross sections
    Enabled: true
    Value: true
    Topic:
      Value: /direct_demo/cross_sections
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/MarkerArray
    Name: Endpoints
    Enabled: true
    Value: true
    Topic:
      Value: /direct_demo/selection
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/Path
    Name: Seed path
    Enabled: true
    Value: true
    Color: 214; 149; 53
    Alpha: 0.85
    Line Style: Billboards
    Line Width: 0.035
    Buffer Length: 1
    Pose Style: None
    Topic:
      Value: /direct_demo/seed
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/Path
    Name: Centerline
    Enabled: true
    Value: true
    Color: 139; 25; 42
    Alpha: 1.0
    Line Style: Billboards
    Line Width: 0.07
    Buffer Length: 1
    Pose Style: None
    Topic:
      Value: /direct_demo/reference
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/MarkerArray
    Name: FIRI corridor
    Enabled: true
    Value: true
    Topic:
      Value: /direct_demo/firi_corridor
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/MarkerArray
    Name: C3 trajectory
    Enabled: true
    Value: true
    Topic:
      Value: /direct_demo/c3_trajectory
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/MarkerArray
    Name: FIRI trajectory
    Enabled: true
    Value: true
    Topic:
      Value: /direct_demo/firi_trajectory
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 244; 247; 251
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /move_base_simple/goal
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 72.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 1.5
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.10
      Target Frame: odom
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.78
    Saved: null
Window Geometry:
  Width: 1660
  Height: 1020
  X: 60
  Y: 50
  Hide Left Dock: false
  Hide Right Dock: true
